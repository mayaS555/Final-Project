# Example settings: copy this file to .env and fill in your own values (.env is not committed).
# Read by `npm run seed` (B); A owns this file and can add the server's settings.

# MongoDB connection string, including the database name. Used by `npm run seed` (B).
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=daily-web

# `npm run seed` refuses to run when this is "production".
NODE_ENV=development

# Logging configuration (optional)
# Log level: debug | info | warn | error | silent   (default: info; test environments default to error)
LOG_LEVEL=info
# Set to "true" to write logs to logs/app.log and logs/error.log in addition to the console
LOG_TO_FILE=false
