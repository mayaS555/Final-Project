# Example settings: copy this file to .env and fill in your own values (.env is not committed).
# Read by `npm run seed` (B); A owns this file and can add the server's settings.

# MongoDB connection string, including the database name. Used by `npm run seed` (B).
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=daily-web

# `npm run seed` refuses to run when this is "production".
NODE_ENV=development

# Passwords for the demo staff accounts created by `npm run seed` (optional; defaults are shown).
# The emails are listed in README.md. Use different values for a shared demo database.
SEED_REPORTER_PASSWORD=reporter123
SEED_EDITOR_PASSWORD=editor123

# Secret used to sign session cookies. Required; there is no fallback.
# Keep the same value across restarts so existing sessions stay valid.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_value

# Logging configuration (optional)
# Log level: debug | info | warn | error | silent   (default: info; test environments default to error)
LOG_LEVEL=info
# Set to "true" to write logs to logs/app.log and logs/error.log in addition to the console
LOG_TO_FILE=false

# ── Weather widget (optional) ────────────────────────────────────────────────
# Obtain a free API key at https://openweathermap.org/api
# Leave unset to disable the widget (it will show "Weather unavailable").
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
# Default city shown in the header widget (can be overridden per-request via ?city=).
WEATHER_DEFAULT_CITY=Tel Aviv
