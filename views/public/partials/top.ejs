<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% if (locals.metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
    <% } %>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/public.css">
    <script src="/js/weather-widget.js" defer></script>
</head>
<body class="pub-site">
    <header class="pub-header">
        <a class="pub-brand" href="/">The Daily Web</a>
        <%- include('weather', { weather: locals.weather || null }) %>
        <nav aria-label="Staff">
            <% if (locals.user) { %>
                <span style="margin-right: 0.75rem; color: #4b5563; font-size: 0.95rem;">Hello, <%= user.name %></span>
                <% if (user.role === 'reporter') { %>
                    <a href="/reporter" style="margin-right: 0.5rem;">Reporter Dashboard</a>
                <% } %>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login.html">Staff Login</a>
            <% } %>
        </nav>
    </header>
