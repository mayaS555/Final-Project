<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <% if (locals.metaDescription) { %>
    <meta name="description" content="<%= metaDescription %>">
    <% } %>
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/public.css">
    <script src="/js/theme-toggle.js"></script>
    <script src="/js/weather-widget.js" defer></script>
</head>
<body class="pub-site">
    <header class="pub-header">
        <a class="pub-brand" href="/">The Daily Web</a>
        <%- include('weather', { weather: locals.weather || null }) %>
        <%# Hidden until theme-toggle.js runs, since it does nothing without JavaScript. %>
        <button type="button" class="theme-toggle" id="theme-toggle" hidden>🌙 Dark</button>
        <nav aria-label="Staff">
            <% if (locals.user) { %>
                <span style="margin-right: 0.75rem; font-size: 0.95rem;">Hello, <%= user.name %></span>
                <% if (user.role === 'reporter' || user.role === 'admin') { %>
                    <a href="/reporter" style="margin-right: 0.5rem;"><%= user.role === 'admin' ? 'Admin Dashboard' : 'Reporter Dashboard' %></a>
                <% } %>
                <% if (user.role === 'editor' || user.role === 'admin') { %>
                    <a href="/editor" style="margin-right: 0.5rem;">Editor Dashboard</a>
                    <a href="/editor/analytics" style="margin-right: 0.5rem;">Impact Analytics</a>
                <% } %>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login.html">Staff Login</a>
            <% } %>
        </nav>
    </header>
