<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.draft.title || 'Untitled' %> | Editor | The Daily Web</title>
  <link rel="stylesheet" href="/css/editor-article.css">
  <link rel="stylesheet" href="/css/editor-integration.css">
  <script src="/js/editor-article.js" defer></script>
</head>
<body>
  <header>
    <h1>The Daily Web</h1>
    <nav aria-label="Staff"><a href="/">Public site</a><a href="/editor">Editor Dashboard</a><a href="/editor/analytics?article=<%= article._id %>">Impact Analytics</a><a href="/logout">Logout</a></nav>
  </header>
  <main class="article-page" id="editor-page" data-article-id="<%= article._id %>">
    <a href="/editor" class="back-link">← Back to Articles</a>
    <p id="editor-message" role="status" aria-live="polite"></p>
    <noscript><p>Enable JavaScript to edit, publish, return or delete this article.</p></noscript>
    <% if (article.approved?.publishedAt) { %>
      <p class="revision-note">Readers see the approved version. <a href="/articles/<%= article._id %>">View live article</a></p>
    <% } %>
    <article class="full-article">
      <div id="article-status" class="article-status <%= article.status === 'returned' ? 'needs-changes' : article.status %>"><%= statusLabel %></div>
      <div id="article-preview">
        <h3>Working copy <%= article.status === 'pending' ? '— waiting for approval' : '' %></h3>
        <h2 id="article-title"><%= article.draft.title || 'Untitled' %></h2>
        <div class="article-details">
          <p>Reporter: <span id="article-reporter"><%= article.authorName %></span></p>
          <p>Created: <span><%= formatDate(article.createdAt) %></span></p>
          <p>Last Updated: <span id="updated-date"><%= formatDate(article.updatedAt) %></span></p>
        </div>
        <p><strong>Category:</strong> <%= article.draft.category || 'Not selected' %></p>
        <p><strong>Image address:</strong> <%= article.draft.imageUrl || 'No image' %></p>
        <p id="article-summary"><%= article.draft.summary %></p>
        <div id="article-content" class="article-content"><%= article.draft.content %></div>
      </div>
      <form id="editor-edit-form" hidden>
        <fieldset id="editor-fields">
          <legend>Edit working copy</legend>
          <label for="edit-title">Title</label>
          <input class="edit-title" id="edit-title" name="title" maxlength="200" value="<%= article.draft.title %>" required>
          <label for="edit-summary">Summary</label>
          <textarea id="edit-summary" name="summary" maxlength="500" rows="3"><%= article.draft.summary %></textarea>
          <label for="edit-category">Category</label>
          <select id="edit-category" name="category" required>
            <option value="">Choose category</option>
            <% for (const category of categories) { %>
              <option value="<%= category %>" <%= article.draft.category === category ? 'selected' : '' %>><%= category %></option>
            <% } %>
          </select>
          <label for="edit-image">Image address</label>
          <input id="edit-image" name="imageUrl" maxlength="2048" value="<%= article.draft.imageUrl %>">
          <label for="edit-content">Article text</label>
          <textarea class="edit-content" id="edit-content" name="content" maxlength="50000" required><%= article.draft.content %></textarea>
        </fieldset>
        <div class="edit-buttons show">
          <button class="save-btn" type="submit" disabled>Save Changes</button>
          <button class="cancel-btn" id="cancel-edit" type="button" disabled>Cancel</button>
        </div>
      </form>
    </article>
    <% if (article.approved?.publishedAt) { %>
      <article class="full-article approved-version">
        <h3>Currently published version — visible to readers</h3><h2><%= article.approved.title %></h2>
        <p>Last approved: <%= formatDate(article.approved.updatedAt) %></p>
        <p><strong>Category:</strong> <%= article.approved.category %></p><p><strong>Image address:</strong> <%= article.approved.imageUrl || 'No image' %></p>
        <p><%= article.approved.summary %></p><div class="article-content"><%= article.approved.content %></div>
      </article>
    <% } %>
    <% if (article.editorNote) { %><p class="editor-note"><strong>Comments for the reporter:</strong> <%= article.editorNote %></p><% } %>
    <section class="editor-actions">
      <h3>Editor Actions</h3>
      <% if (!canEdit && !canApprove && !canReturn) { %>
        <p>Review and editing are available when the reporter submits an article for approval.</p>
      <% } %>
      <div class="action-buttons" id="action-buttons">
        <% if (canEdit) { %><button class="edit-btn" id="start-edit" type="button" disabled>Edit Article</button><% } %>
        <% if (canApprove) { %><button class="publish-btn" id="approve-article" type="button" disabled>Approve &amp; Publish</button><% } %>
        <% if (canReturn) { %><button class="return-btn" id="show-return" type="button" disabled>Return for Changes</button><% } %>
        <% if (canRemove) { %><button class="delete-btn" id="delete-article" type="button" disabled>Delete Article</button><% } %>
      </div>
    </section>
    <% if (canReturn) { %>
      <section class="return-section" id="return-section" hidden>
        <h3>Return Article for Changes</h3>
        <form id="editor-return-form">
          <label for="editor-comment">Comments for the reporter</label>
          <textarea id="editor-comment" name="note" rows="6" maxlength="1000" placeholder="Explain what changes are required..." required></textarea>
          <button class="send-return-btn" type="submit" disabled>Return Article</button>
        </form>
      </section>
    <% } %>
  </main>
</body>
</html>
