<%- include("../public/partials/top", { pageTitle: "Impact Analytics | The Daily Web" }) %>
  <link rel="stylesheet" href="/css/editor.css"><link rel="stylesheet" href="/css/editor-integration.css">
  <link rel="stylesheet" href="/css/impact-analytics.css">
  <script src="/js/impact-chart.js" defer></script><script src="/js/impact-analytics.js" defer></script>
  <main class="impact-page">
    <h2>Impact Analytics</h2><p>Explore article views before and after each approved publication or update.</p>
    <section class="impact-controls">
      <form id="article-search"><label for="impact-search">Find an article</label><div class="search-row"><input id="impact-search" maxlength="100" placeholder="Search by title"><button type="submit">Search</button></div></form>
      <form id="impact-controls">
        <label for="impact-article">Article</label><select id="impact-article" required><option value="">Choose an article</option></select>
        <div class="range-row">
          <div><label for="impact-from">From (UTC)</label><input type="datetime-local" id="impact-from" required></div>
          <div><label for="impact-to">To (UTC)</label><input type="datetime-local" id="impact-to" required></div>
          <div><label for="impact-resolution">Views per</label><select id="impact-resolution"><option value="day">Day</option><option value="hour">Hour</option><option value="minute">Minute</option></select></div>
        </div>
        <p class="range-hint">Select an hour or minute interval to inspect an update closely. Maximum 1500 points; all times are UTC.</p>
        <button type="submit" id="impact-refresh">Show graph</button>
      </form>
    </section>
    <p id="impact-status" role="status" aria-live="polite"></p>
    <p id="impact-warning" class="revision-note" hidden></p>
    <section id="impact-result" hidden>
      <div class="impact-summary"><h3 id="impact-title"></h3><p id="impact-total"></p><p id="impact-range-total"></p></div>
      <div class="chart-legend"><span class="legend-line">Views in each interval</span><span class="legend-first">First publication</span><span class="legend-update">Approved update</span></div>
      <div class="impact-chart-wrap"><canvas id="impact-chart" height="360" role="img" aria-label="Views over time with publication and update markers"></canvas></div>
      <p id="impact-hover" aria-live="polite">Move over the graph for interval details.</p>
      <p>Markers show the exact approval time. Counts are grouped by the selected interval, so activity within one interval cannot be separated further.</p>
      <h3>Publication timeline</h3><p id="impact-no-markers" hidden>No publication events in this date range.</p><ol id="impact-events"></ol>
      <details><summary>View graph data as a table</summary><div class="impact-table-wrap"><table><caption>Views per interval (UTC)</caption><thead><tr><th>Interval start</th><th>Views</th></tr></thead><tbody id="impact-table"></tbody></table></div></details>
      <section class="impact-delete-panel" aria-label="Manage view statistics">
        <h3>Delete view statistics</h3>
        <p>Select Day and display the graph first. This action permanently deletes view data for the displayed whole UTC days and updates the total. It keeps the article and its publication timeline.</p>
        <button type="button" id="impact-delete" disabled>Delete displayed view data</button>
      </section>
    </section>
    <noscript><p>Enable JavaScript to select an article and load analytics.</p></noscript>
  </main>
<%- include("../public/partials/bottom") %>
